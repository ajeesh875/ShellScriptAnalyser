{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "format": "uuid",
          "title": "Artifactid",
          "type": "string"
        },
        "artifactType": {
          "$ref": "#/$defs/ArtifactType"
        },
        "fileName": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "contentType": {
          "minLength": 1,
          "title": "Contenttype",
          "type": "string"
        },
        "storageReference": {
          "minLength": 1,
          "title": "Storagereference",
          "type": "string"
        },
        "checksumAlgorithm": {
          "$ref": "#/$defs/ChecksumAlgorithm",
          "default": "SHA256"
        },
        "checksum": {
          "maxLength": 128,
          "minLength": 32,
          "title": "Checksum",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "version": {
          "default": "1.0",
          "pattern": "^1\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "artifactType",
        "fileName",
        "contentType",
        "storageReference",
        "checksum",
        "sizeBytes"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "SOURCE_POINT_CLOUD",
        "CANONICAL_POINT_CLOUD",
        "SEGMENTATION_RESULT",
        "GEOMETRY_MODEL",
        "IFC_MODEL_UNVALIDATED",
        "IFC_MODEL",
        "VALIDATION_REPORT"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ChecksumAlgorithm": {
      "enum": [
        "SHA256"
      ],
      "title": "ChecksumAlgorithm",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ifcModelId": {
      "format": "uuid",
      "title": "Ifcmodelid",
      "type": "string"
    },
    "ifcArtifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "validationPolicy": {
      "default": "MVP_FEASIBILITY_V1",
      "minLength": 1,
      "title": "Validationpolicy",
      "type": "string"
    }
  },
  "required": [
    "ifcModelId",
    "ifcArtifact"
  ],
  "title": "ValidateIFCData",
  "type": "object"
}