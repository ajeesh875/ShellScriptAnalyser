{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "format": "uuid",
          "title": "Artifactid",
          "type": "string"
        },
        "artifactType": {
          "$ref": "#/$defs/ArtifactType"
        },
        "fileName": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "contentType": {
          "minLength": 1,
          "title": "Contenttype",
          "type": "string"
        },
        "storageReference": {
          "minLength": 1,
          "title": "Storagereference",
          "type": "string"
        },
        "checksumAlgorithm": {
          "$ref": "#/$defs/ChecksumAlgorithm",
          "default": "SHA256"
        },
        "checksum": {
          "maxLength": 128,
          "minLength": 32,
          "title": "Checksum",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "version": {
          "default": "1.0",
          "pattern": "^1\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "artifactType",
        "fileName",
        "contentType",
        "storageReference",
        "checksum",
        "sizeBytes"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "SOURCE_POINT_CLOUD",
        "CANONICAL_POINT_CLOUD",
        "SEGMENTATION_RESULT",
        "GEOMETRY_MODEL",
        "IFC_MODEL_UNVALIDATED",
        "IFC_MODEL",
        "VALIDATION_REPORT"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ChecksumAlgorithm": {
      "enum": [
        "SHA256"
      ],
      "title": "ChecksumAlgorithm",
      "type": "string"
    },
    "ModelSelection": {
      "additionalProperties": false,
      "properties": {
        "modelName": {
          "minLength": 1,
          "title": "Modelname",
          "type": "string"
        },
        "modelVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelversion"
        }
      },
      "required": [
        "modelName"
      ],
      "title": "ModelSelection",
      "type": "object"
    },
    "SegmentationOptions": {
      "additionalProperties": false,
      "properties": {
        "useAvailableSemanticLabels": {
          "default": true,
          "title": "Useavailablesemanticlabels",
          "type": "boolean"
        }
      },
      "title": "SegmentationOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonicalArtifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "minItems": 1,
      "title": "Canonicalartifacts",
      "type": "array"
    },
    "modelSelection": {
      "$ref": "#/$defs/ModelSelection"
    },
    "processingOptions": {
      "$ref": "#/$defs/SegmentationOptions",
      "default": {
        "useAvailableSemanticLabels": true
      }
    }
  },
  "required": [
    "canonicalArtifacts",
    "modelSelection"
  ],
  "title": "StartSegmentationData",
  "type": "object"
}