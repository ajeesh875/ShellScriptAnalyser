{
  "$defs": {
    "WorkflowStage": {
      "enum": [
        "SEGMENTATION",
        "GEOMETRY_EXTRACTION",
        "IFC_GENERATION",
        "IFC_VALIDATION",
        "ARTIFACT_PREPARATION",
        "COMPLETED"
      ],
      "title": "WorkflowStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "errorCode": {
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "title": "Errorcode",
      "type": "string"
    },
    "errorCategory": {
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "title": "Errorcategory",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "failedStage": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "attempt": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt"
    },
    "detailsReference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detailsreference"
    }
  },
  "required": [
    "errorCode",
    "errorCategory",
    "message",
    "retryable"
  ],
  "title": "CommonError",
  "type": "object"
}