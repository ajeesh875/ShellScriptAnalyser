              <mxPoint x="1170" y="820" />
              <mxPoint x="1170" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="sig_ifc" value="HTTP Signal&lt;br&gt;IFC CREATION COMPLETED" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#009900;fontSize=8;" edge="1" parent="1" source="ifc_ms" target="signal_ctrl">
          <mxGeometry relative="1" as="geometry">
