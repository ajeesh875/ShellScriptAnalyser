            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="sig_pp" value="HTTP Signal&lt;br&gt;POST PROCESSING COMPLETED" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#009900;fontSize=8;" edge="1" parent="1" source="pp_ms" target="signal_ctrl">
          <mxGeometry relative="1" as="geometry">
