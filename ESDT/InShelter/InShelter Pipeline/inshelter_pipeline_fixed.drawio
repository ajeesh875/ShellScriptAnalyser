        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;—— Blue: Queue dispatch&lt;br&gt;—— Orange: Data transfer (Blob/JSON)&lt;br&gt;- - - Green: HTTP completion signals&lt;br&gt;—— Black: Webhook / API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
